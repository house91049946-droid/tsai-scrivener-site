---
// src/pages/contact.astro — 聯絡我們
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
---
<Base title="聯絡我們｜台中中友地政士事務所" description="中友地政士事務所聯絡方式：電話 0915-006-336、LINE @0955377283。事務所位於台中市東區東英七街 55 號。">
  <PageBanner title="聯絡我們" sub="CONTACT" />
  <main class="wrap contact">
    <p class="crumb"><a href="/">首頁</a> / 聯絡我們</p>
    <h1 class="page-title">先講你的情況，我們告訴你下一步</h1>
    <div class="grid">
      <div class="ways">
        <a class="way" href="tel:+886915006336"><small>電話（丁玉梅地政士）</small><b>0915-006-336</b></a>
        <a class="way" href="https://line.me/R/ti/p/%400955377283" target="_blank" rel="noopener"><small>LINE 官方帳號</small><b>@0955377283</b></a>
        <a class="way" href="https://www.facebook.com/chunhao.tsai1" target="_blank" rel="noopener"><small>Facebook</small><b>蔡峻豪地政士</b></a>
        <div class="way"><small>事務所</small><b>中友地政士事務所</b><span>台中市東區東英七街 55 號</span></div>
        <p class="hint">初步討論不收費。長輩行動不便或住院，可安排到府、到院辦理。</p>
      </div>
      <div class="maps">
        <iframe title="中友地政士事務所地圖" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=台中市東區東英七街55號&output=embed"></iframe>
      </div>
    </div>
  </main>
</Base>
<style>
.grid{display:grid; grid-template-columns:1fr 1.2fr; gap:36px}
.ways{display:grid; gap:12px; align-content:start}
.way{display:grid; gap:2px; padding:16px 18px; border:1px solid var(--line); border-radius:var(--radius); text-decoration:none; color:var(--text); background:#fff}
a.way:hover{border-color:var(--blue); box-shadow:var(--shadow)}
.way small{font-size:12px; letter-spacing:.2em; color:var(--sub)}
.way b{font-size:19px; color:var(--blue)}
.way span{font-size:14px; color:var(--sub)}
.hint{font-size:13.5px; color:var(--sub); margin:6px 0 0}
.maps{display:grid; gap:16px}
.maps iframe{width:100%; height:420px; border:0; border-radius:var(--radius)}
@media (max-width:820px){ .grid{grid-template-columns:1fr} }
</style>
