---
// src/pages/tools/index.astro — 試算工具總覽（四種稅）
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/PageBanner.astro';
const tools = [
  { href: '/tools/estate-tax/', en: 'Estate Tax', h: '遺產稅試算', p: '免稅額 1,333 萬、配偶 553 萬、子女每人 56 萬，三級距自動算。', img: '/photo/svc-inherit.webp' },
  { href: '/tools/gift-tax/', en: 'Gift Tax', h: '贈與稅試算', p: '每人每年 244 萬免稅額怎麼用？父母雙方、婚嫁贈與一次算清。', img: '/photo/svc-gift.webp' },
  { href: '/tools/property-tax/', en: 'Property Tax', h: '房地合一稅試算', p: '持有年限決定稅率 45% 還是 15%；自住 400 萬免稅，賣之前先算。', img: '/photo/svc-ptax.webp' },
  { href: '/tools/land-tax/', en: 'Land Value Tax', h: '土地增值稅試算', p: '漲價倍數 20%～40% 累進、長期持有減徵，和自用住宅 10% 一次比較。', img: '/photo/hero-street.webp' },
];
---
<Base title="稅費線上試算｜遺產稅・贈與稅・房地合一稅・土地增值稅｜中友地政士事務所"
  description="免費線上試算四種不動產稅：遺產稅、贈與稅、房地合一稅、土地增值稅。依 115 年度（2026）現行規定，附法條依據。台中中友地政士事務所提供。">
  <PageBanner title="稅費試算" sub="SIMULATOR" img="/photo/svc-estate.webp" />
  <main class="wrap tools">
    <p class="crumb"><a href="/">首頁</a> / 稅費試算</p>
    <h1 class="page-title">稅費線上試算：遺產稅・贈與稅・房地合一稅・土地增值稅</h1>
    <p class="lead">傳承的每個決定都牽動稅金。先自己算清楚，數字有眉角的地方，我們再幫你把關。</p>
    <div class="grid">
      {tools.map((t) => (
        <a class="card reveal" href={t.href}>
          <span class="ph"><img src={t.img} alt="" width="900" height="505" loading="lazy" /></span>
          <span class="en">{t.en}</span>
          <h2>{t.h}</h2>
          <p>{t.p}</p>
          <span class="go">開始試算 <i class="pill">→</i></span>
        </a>
      ))}
    </div>
  </main>
</Base>
<style>
.tools{padding-bottom:40px}
.lead{color:var(--sub); margin-bottom:40px; font-size:14.5px}
.grid{display:grid; grid-template-columns:repeat(2,1fr); gap:clamp(24px,3vw,44px)}
.card{display:grid; gap:8px; text-decoration:none; color:inherit}
.card .ph{overflow:hidden; aspect-ratio:16/9; margin-bottom:10px}
.card img{width:100%; height:100%; object-fit:cover; transition:transform 1.2s cubic-bezier(.19,1,.22,1)}
.card:hover img{transform:scale(1.05)}
.card .en{font-size:13px; color:var(--sub)}
.card h2{font-size:20px; font-weight:500; letter-spacing:.14em}
.card p{font-size:14px; line-height:2.1; margin:0}
.go{display:flex; align-items:center; gap:10px; font-size:13px; margin-top:6px}
@media (max-width:700px){ .grid{grid-template-columns:1fr} }
</style>
