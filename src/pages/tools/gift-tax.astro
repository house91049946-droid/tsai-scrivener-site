---
// src/pages/tools/gift-tax.astro — 贈與稅試算（2026 現行稅制）
// 稅率法源：遺產及贈與稅法 §19（稅率級距）、§22（免稅額 244 萬）
// 2026 級距：淨額 ≤2,811萬 10%；2,811萬–5,621萬 15%（累進差額 140.55萬）；>5,621萬 20%（累進差額 421.6萬）
import Base from '../../layouts/Base.astro';
import '../../styles/tool.css';
---
<Base title="贈與稅試算 2026｜免稅額 244 萬與級距一次算清｜中友地政士事務所"
  description="2026（115年度）贈與稅線上試算：每人每年免稅額 244 萬、父母合計 488 萬、婚嫁 100 萬，三級距 10%～20% 自動計算，附法條依據。台中中友地政士事務所提供。">
  <main class="tool">
    <p class="crumb"><a href="/tools/">試算工具</a> / 贈與稅</p>
    <h1>贈與稅試算<span class="yr">2026</span></h1>
    <p class="lead">爸媽把財產先給孩子，稅怎麼算？輸入金額，馬上看要繳多少、怎麼省。</p>

    <div class="calc" data-io>
      <div class="panel reveal">
        <label for="amount">本年度贈與總額（萬元）</label>
        <input id="amount" type="number" inputmode="numeric" min="0" step="10" placeholder="例如 1000" />

        <fieldset>
          <legend>贈與人</legend>
          <label class="opt"><input type="radio" name="donors" value="1" checked />單一贈與人（免稅額 244 萬）</label>
          <label class="opt"><input type="radio" name="donors" value="2" />父母雙方均分（各 244 萬，合計 488 萬）</label>
        </fieldset>

        <label class="opt chk"><input type="checkbox" id="marriage" />
          子女婚嫁贈與（結婚登記前後 6 個月內，每位贈與人另享 100 萬免稅）</label>

        <button id="calc-btn" type="button">試算</button>
      </div>

      <div class="panel result reveal d2" id="result" hidden>
        <div class="sum"><span>應納贈與稅額</span><b id="tax-out" class="num">0</b><i>元</i></div>
        <div class="steps" id="steps"></div>
        <a class="cta" href="https://line.me/R/ti/p/%400955377283" target="_blank" rel="noopener">贈與的時點與方式有眉角——LINE 找我們聊聊</a>
      </div>
    </div>

    <section class="ref">
      <h2>2026 贈與稅級距表</h2>
      <div class="tbl-wrap">
        <table>
          <thead><tr><th>贈與淨額（課稅基礎）</th><th>稅率</th><th>累進差額</th></tr></thead>
          <tbody>
            <tr><td>2,811 萬元以下</td><td>10%</td><td>—</td></tr>
            <tr><td>2,811 萬 – 5,621 萬元</td><td>15%</td><td>140.55 萬元</td></tr>
            <tr><td>超過 5,621 萬元</td><td>20%</td><td>421.6 萬元</td></tr>
          </tbody>
        </table>
      </div>
      <ul class="notes">
        <li>免稅額為<b>每一贈與人、每一年度</b> 244 萬元；父母各自有額度。</li>
        <li>贈與淨額＝贈與總額 − 免稅額 −（符合條件之婚嫁免稅 100 萬）− 依法可扣除項目。</li>
        <li>超過免稅額之贈與，應於贈與行為發生後 30 日內申報。</li>
        <li>想比較身後繼承的稅負，可用<a href="/tools/estate-tax/">遺產稅試算</a>；完整服務見<a href="/services/#succession">財產傳承規劃</a>。</li>
        <li>法條依據：<a href="https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=G0340072&flno=19" rel="noopener">遺產及贈與稅法第 19 條</a>、<a href="https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=G0340072&flno=22" rel="noopener">第 22 條</a>。</li>
      </ul>
      <p class="disclaimer">本試算為一般性估算，未涵蓋附有負擔之贈與、公告現值評定、二親等買賣視同贈與等個案情形，實際稅額以稽徵機關核定為準；非個案法律或稅務意見。</p>
    </section>
  </main>
</Base>

<script>
  const fmt = (n: number) => Math.round(n).toLocaleString('zh-Hant-TW');
  // 單一贈與人稅額（單位：萬）
  function taxPerDonor(net: number): number {
    if (net <= 0) return 0;
    if (net <= 2811) return net * 0.10;
    if (net <= 5621) return net * 0.15 - 140.55;
    return net * 0.20 - 421.6;
  }
  const $ = (id: string) => document.getElementById(id)!;
  $('calc-btn').addEventListener('click', () => {
    const total = Math.max(0, Number(($('amount') as HTMLInputElement).value) || 0);
    const donors = Number((document.querySelector('input[name="donors"]:checked') as HTMLInputElement).value);
    const marriage = ($('marriage') as HTMLInputElement).checked;
    const per = total / donors;
    const exempt = 244 + (marriage ? 100 : 0);
    const netPer = Math.max(0, per - exempt);
    const taxPer = taxPerDonor(netPer);
    const taxTotal = taxPer * donors; // 萬 → 元
    const out = $('tax-out');
    const target = taxTotal * 10000;

    $('result').hidden = false;
    const rate = netPer <= 0 ? '—' : netPer <= 2811 ? '10%' : netPer <= 5621 ? '15%' : '20%';
    $('steps').innerHTML =
      `<p>每位贈與人：贈與額 ${fmt(per)} 萬 − 免稅額 ${fmt(exempt)} 萬 ＝ 淨額 <b>${fmt(netPer)} 萬</b>（適用稅率 ${rate}）</p>` +
      `<p>稅額 ${fmt(taxPer)} 萬 × ${donors} 位贈與人 ＝ 合計 <b>${fmt(taxTotal)} 萬元</b></p>` +
      (netPer <= 0 ? `<p class="good">在免稅額內，本年度免繳贈與稅。</p>` : '');

    // 數字滾動（reduced-motion 直接顯示）
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { out.textContent = fmt(target); return; }
    let t0: number | null = null;
    const dur = 900;
    function step(t: number) {
      if (!t0) t0 = t;
      const p = Math.min((t - t0) / dur, 1), eased = 1 - Math.pow(1 - p, 3);
      out.textContent = fmt(target * eased);
      if (p < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  });
</script>

