---
// src/pages/index.astro — 首頁（2026-09 改版：事務所藍白版型）
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import fs from 'node:fs';

const posts = (await getCollection('posts')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 4);
// 事務所實景照到位後放 public/img/hero-office.jpg，沒有就用主筆人像
const hasOffice = fs.existsSync('public/img/hero-office.jpg');

const flow = [
  { n: '01', i: 'phone', t: '來電諮詢', d: '電話或 LINE 說明情況，先告訴你會遇到哪些稅、大概流程。' },
  { n: '02', i: 'calc', t: '稅費試算', d: '遺產稅、贈與稅、土增稅、契稅先算清楚，再決定做不做。' },
  { n: '03', i: 'sign', t: '委任簽約', d: '確認委任範圍與費用，白紙黑字，沒有隱藏收費。' },
  { n: '04', i: 'folder', t: '代書流程', d: '申報、完稅、送件、領狀，進度主動回報。' },
  { n: '05', i: 'done', t: '圓滿結案', d: '交付權狀與完稅證明，後續傳承規劃持續諮詢。' },
];
const cover: Record<string, string> = { 稅務: 'tax', 繼承實務: 'inherit', 贈與節稅: 'gift', 買賣過戶: 'transfer', 抵押設定: 'mortgage' };
const services = [
  { h: '遺產稅申報與規劃', d: '免稅額 1,333 萬、扣除額逐項核對，分期與實物抵繳評估。', href: '/services/#estate-tax', img: 'estate' },
  { h: '贈與稅與分年贈與', d: '每人每年 244 萬免稅額怎麼用、婚嫁 100 萬、視同贈與怎麼避。', href: '/services/#gift-tax', img: 'gift' },
  { h: '繼承登記與遺產分割', d: '繼承系統表、分割協議書、公同共有登記，6 個月期限守住。', href: '/services/#inheritance', img: 'inherit' },
  { h: '家族財產傳承規劃', d: '生前贈與或身後繼承，兩條路的稅負算給你看。', href: '/services/#succession', img: 'plan' },
  { h: '房地合一稅與土增稅', d: '持有期間、自用住宅優惠、重購退稅，賣房前先算。', href: '/services/#property-tax', img: 'ptax' },
  { h: '買賣過戶與抵押設定', d: '產權調查、履約保證、完稅送件到領狀全程辦理。', href: '/services/#transfer', img: 'transfer' },
];
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: '2026（民國115年）遺產稅免稅額是多少？', acceptedAnswer: { '@type': 'Answer', text: '遺產稅免稅額為新臺幣 1,333 萬元。另有配偶扣除額 553 萬元、直系血親卑親屬每人 56 萬元、父母每人 138 萬元、喪葬費 138 萬元等扣除額。遺產淨額 5,621 萬元以下適用 10%，5,621 萬至 1 億 1,242 萬元適用 15%，超過部分適用 20%。' } },
    { '@type': 'Question', name: '贈與稅一年可以免稅贈與多少？', acceptedAnswer: { '@type': 'Answer', text: '每一位贈與人每年有 244 萬元免稅額，父母各自計算。子女婚嫁時，每位贈與人另有 100 萬元免稅額（結婚登記前後 6 個月內）。超過免稅額的部分應於贈與後 30 日內申報。' } },
    { '@type': 'Question', name: '繼承登記有期限嗎？沒辦會怎樣？', acceptedAnswer: { '@type': 'Answer', text: '遺產稅應於死亡之日起 6 個月內申報，繼承登記亦應自繼承開始之日起 6 個月內申請。逾期未辦繼承登記會被處罰鍰並列冊管理，未完成登記前該不動產無法出售、設定抵押或處分。' } },
  ],
};
---
<Base
  title="台中代書推薦｜中友地政士事務所｜遺產稅・贈與稅・繼承登記"
  description="台中中友地政士事務所，三位地政士的代書世家。專辦遺產稅申報、贈與稅規劃、繼承登記與家族財產傳承。台中東區、太平兩個據點，先把稅算清楚再決定。電話 0955-377-283。"
  schema={faq}
>
  <main>
    <!-- 首屏 -->
    <section class={`hero ${hasOffice ? 'office' : 'portrait'}`}>
      <img class="bg" src={hasOffice ? '/img/hero-office.jpg' : '/illus/hero.svg'} alt="台中中友地政士事務所" width="1600" height="640" fetchpriority="high" />
      <div class="wrap hero-in">
        <h1>台中代書推薦｜中友地政士事務所</h1>
        <div class="box">
          <b>先把稅算清楚，再決定怎麼傳。</b>
          <span>遺產稅・贈與稅・繼承登記・財產傳承規劃</span>
        </div>
      </div>
    </section>
    <p class="kwline wrap">台中地政士事務所・東區地政士事務所・太平代書推薦・遺產稅申報・贈與稅試算・繼承登記</p>

    <!-- 服務流程 -->
    <section class="section" id="flow">
      <div class="wrap">
        <div class="sec-title"><h2>服務流程</h2><small>PROCESS</small></div>
        <ol class="flow">
          {flow.map((f) => <li class="reveal"><span class="n"><img src={`/illus/flow-${f.i}.svg`} alt="" width="120" height="120" loading="lazy" /><i>{f.n}</i></span><b>{f.t}</b><p>{f.d}</p></li>)}
        </ol>
      </div>
    </section>

    <!-- 品牌文 -->
    <section class="section grey" id="about">
      <div class="wrap brand">
        <div class="pic reveal"><img src="/img/p-jh.jpg" alt="蔡峻豪地政士" width="840" height="1120" loading="lazy" /></div>
        <div class="txt reveal">
          <blockquote>「家的傳承，交給一家人把關。」</blockquote>
          <p>中友地政士事務所是一個代書世家，三位地政士——蔡峻豪、蔡崇欽、丁玉梅——在同一個事務所執業。每一件案子，不是一個人的判斷，是一家人三張執照一起看。</p>
          <p>我們把重心放在稅：遺產稅、贈與稅、房地合一稅、土地增值稅。因為在傳承這件事上，登記只是最後一步，決定你多繳還是少繳的，是前面那些沒人跟你算清楚的數字。</p>
          <p>我們習慣把生硬的法條翻成人話，透明報價、主動回報進度。不論是疑難產權，還是長輩還健康時就想先安排的傳承布局，先講你的情況，我們告訴你會遇到什麼、下一步是什麼。</p>
          <div class="btns"><a class="btn" href="/about/">認識中友</a><a class="btn outline" href="/tools/">免費試算稅費</a></div>
        </div>
      </div>
    </section>

    <!-- 三位地政士 -->
    <section class="section" id="people">
      <div class="wrap">
        <div class="sec-title"><h2>三位地政士</h2><small>OUR TEAM</small><p>代書世家，一家人三張執照一起把關。</p></div>
        <div class="team">
          <figure class="reveal"><img src="/img/p-jh.jpg" alt="蔡峻豪 地政士" width="840" height="1120" loading="lazy" /><figcaption><b>蔡峻豪</b><small>地政士・主筆</small><p>地政士、不動產經紀人、土地開發師。本站文章的執筆與審定人。</p></figcaption></figure>
          <figure class="reveal"><img src="/img/p-cq.jpg" alt="蔡崇欽 地政士" width="840" height="1120" loading="lazy" /><figcaption><b>蔡崇欽</b><small>地政士</small><p class="pend">［待補：專長與經歷］</p></figcaption></figure>
          <figure class="reveal"><img src="/img/p-dg.jpg" alt="丁玉梅 地政士" width="840" height="1120" loading="lazy" /><figcaption><b>丁玉梅</b><small>地政士</small><p class="pend">［待補：專長與經歷］</p></figcaption></figure>
        </div>
      </div>
    </section>

    <!-- 服務項目 -->
    <section class="section" id="svc">
      <div class="wrap">
        <div class="sec-title"><h2>服務項目</h2><small>SERVICE</small></div>
        <div class="svc">
          {services.map((s) => <a class="card reveal" href={s.href}><img src={`/illus/svc-${s.img}.svg`} alt="" width="400" height="220" loading="lazy" /><div class="cb"><h3>{s.h}</h3><p>{s.d}</p><span>詳細說明 ›</span></div></a>)}
        </div>
      </div>
    </section>

    <!-- 據點 -->
    <section class="section grey" id="loc">
      <div class="wrap">
        <div class="sec-title"><h2>服務據點</h2><small>LOCATION</small></div>
        <div class="loc">
          <div class="place reveal">
            <iframe title="中友地政士事務所地圖" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=台中市東區東英七街55號&output=embed"></iframe>
            <div class="info"><b>中友地政士事務所</b><p>台中市東區東英七街 55 號</p><a href="https://www.google.com/maps/search/?api=1&query=台中市東區東英七街55號" target="_blank" rel="noopener">Google 地圖導航 ›</a></div>
          </div>
          <div class="place reveal">
            <iframe title="有巢氏太平中山富盛店地圖" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=台中市太平區中山路四段122號&output=embed"></iframe>
            <div class="info"><b>有巢氏房屋 太平中山富盛店</b><p>台中市太平區中山路四段 122 號</p><a href="https://www.google.com/maps/search/?api=1&query=台中市太平區中山路四段122號" target="_blank" rel="noopener">Google 地圖導航 ›</a></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 最新文章 -->
    <section class="section" id="news">
      <div class="wrap">
        <div class="sec-title"><h2>最新文章</h2><small>ARTICLE</small></div>
        <div class="news">
          {posts.map((p) => (
            <a class="post reveal" href={`/posts/${p.id.replace(/\.md$/, '')}/`}>
              <img src={`/illus/cover-${cover[p.data.category] ?? 'tax'}.svg`} alt="" width="800" height="400" loading="lazy" />
              <div class="pb">
              <span class="cat">{p.data.category}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <time>發佈：{p.data.date.toISOString().slice(0, 10).replaceAll('-', '/')}</time>
              </div>
            </a>
          ))}
        </div>
        <div class="more"><a class="btn outline" href="/posts/">看全部文章</a></div>
      </div>
    </section>

    <!-- 聯絡 -->
    <section class="section contact-band" id="contact">
      <div class="wrap">
        <h2>免費初步諮詢，先講你的情況。</h2>
        <p>電話 <a href="tel:+886955377283">0955-377-283</a>｜LINE <a href="https://line.me/R/ti/p/%400955377283" target="_blank" rel="noopener">@0955377283</a></p>
        <div class="btns"><a class="btn line" href="https://line.me/R/ti/p/%400955377283" target="_blank" rel="noopener">LINE 諮詢</a><a class="btn outline" href="/contact/">聯絡我們</a></div>
      </div>
    </section>
  </main>
</Base>

<style>
/* 首屏 */
.hero{position:relative; min-height:clamp(380px,40vw,640px); overflow:hidden; background:#EEF3FA}
.hero .bg{position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center bottom}
.hero-in{position:relative; height:100%; min-height:inherit}
.hero h1{position:absolute; left:clamp(16px,4vw,40px); top:clamp(40px,6vw,80px); font-size:clamp(20px,2.6vw,32px); color:var(--blue-d); letter-spacing:.1em}
.hero .box{position:absolute; left:clamp(16px,4vw,40px); bottom:clamp(40px,7vw,90px); background:var(--blue); color:#fff; padding:22px 30px; border-radius:var(--radius);
  box-shadow:0 10px 30px rgba(20,40,80,.25); display:grid; gap:6px; max-width:min(92%,520px)}
.hero .box b{font-size:clamp(20px,2.4vw,30px); letter-spacing:.1em; line-height:1.4}
.hero .box span{font-size:13.5px; letter-spacing:.12em; color:rgba(255,255,255,.85)}
.kwline{font-size:12px; color:var(--sub); letter-spacing:.08em; padding-block:10px; border-bottom:1px solid var(--line)}
@media (max-width:760px){
  .hero{min-height:0; aspect-ratio:1/1}
  .hero h1{font-size:18px}
  .hero .box{left:16px; right:16px; bottom:22px; padding:16px 18px}
}

/* 流程 */
.flow{list-style:none; padding:0; margin:0; display:grid; grid-template-columns:repeat(5,1fr); gap:18px; counter-reset:f}
.flow li{text-align:center; position:relative; padding:0 6px}
.flow li:not(:last-child)::after{content:""; position:absolute; right:-14px; top:38px; width:12px; height:12px; border-right:2px solid var(--line); border-bottom:2px solid var(--line); transform:rotate(-45deg)}
.flow .n{position:relative; display:grid; place-items:center; width:104px; height:104px; margin:0 auto 14px; border-radius:50%; border:2px solid var(--blue-l); background:#fff}
.flow .n img{width:64px; height:64px}
.flow .n i{position:absolute; right:-4px; top:-4px; width:30px; height:30px; border-radius:50%; background:var(--blue); color:#fff; font-style:normal; font-size:12px; font-weight:700; display:grid; place-items:center}
.flow b{display:block; color:var(--ink); font-size:17px; letter-spacing:.1em; margin-bottom:6px}
.flow p{font-size:13.5px; color:var(--sub); margin:0}
@media (max-width:900px){ .flow{grid-template-columns:repeat(2,1fr)} .flow li::after{display:none} .flow li:last-child{grid-column:1/-1} }

/* 品牌文 */
.brand{display:grid; grid-template-columns:.8fr 1.2fr; gap:clamp(24px,5vw,64px); align-items:center}
.brand .pic{border-radius:var(--radius); overflow:hidden; box-shadow:var(--shadow)}
.brand blockquote{font-size:clamp(22px,2.6vw,30px); font-weight:700; color:var(--blue); letter-spacing:.08em; margin:0 0 20px}
.brand p{margin:0 0 14px}
.btns{display:flex; gap:12px; flex-wrap:wrap; margin-top:22px}
@media (max-width:820px){ .brand{grid-template-columns:1fr} .brand .pic{max-width:360px} }

/* 服務 */
.svc{display:grid; grid-template-columns:repeat(3,1fr); gap:20px}
.card{background:#fff; border:1px solid var(--line); text-decoration:none; color:var(--text); overflow:hidden;
  border-radius:var(--radius); transition:transform .3s,box-shadow .3s; display:grid; grid-template-rows:auto 1fr}
.card img{width:100%; height:auto; aspect-ratio:400/220; object-fit:cover; border-bottom:1px solid var(--line)}
.card .cb{padding:20px 22px 22px; display:grid; gap:8px}
.card:hover{transform:translateY(-4px); box-shadow:var(--shadow)}
.card h3{font-size:18px}
.card p{font-size:14px; color:var(--sub); margin:0}
.card span{color:var(--blue); font-size:13.5px; font-weight:700}
@media (max-width:900px){ .svc{grid-template-columns:1fr 1fr} }
@media (max-width:600px){ .svc{grid-template-columns:1fr} }

/* 據點 */
.loc{display:grid; grid-template-columns:1fr 1fr; gap:24px}
.place{background:#fff; border:1px solid var(--line); border-radius:var(--radius); overflow:hidden}
.place iframe{width:100%; height:240px; border:0; display:block}
.place .info{padding:18px 20px}
.place b{display:block; color:var(--ink); font-size:17px; margin-bottom:4px}
.place p{margin:0 0 8px; color:var(--sub); font-size:14.5px}
.place a{color:var(--blue); text-decoration:none; font-weight:700; font-size:14px}
@media (max-width:760px){ .loc{grid-template-columns:1fr} }

/* 文章 */
.news{display:grid; grid-template-columns:repeat(2,1fr); gap:18px}
.post{display:grid; grid-template-columns:220px 1fr; border:1px solid var(--line); border-radius:var(--radius); text-decoration:none; color:var(--text); background:#fff; overflow:hidden; transition:box-shadow .3s,border-color .3s}
.post img{width:100%; height:100%; object-fit:cover; border-right:1px solid var(--line)}
.post .pb{display:grid; gap:6px; padding:18px 20px; align-content:start}
.post:hover{box-shadow:var(--shadow); border-color:var(--blue)}
.post .cat{font-size:12px; color:var(--blue); font-weight:700; letter-spacing:.14em}
.post h3{font-size:17px; line-height:1.5}
.post p{font-size:13.5px; color:var(--sub); margin:0; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden}
.post time{font-size:12.5px; color:var(--sub)}
.more{display:flex; justify-content:center; margin-top:30px}
@media (max-width:1000px){ .news{grid-template-columns:1fr} }
@media (max-width:520px){ .post{grid-template-columns:1fr} .post img{aspect-ratio:2/1; border-right:0; border-bottom:1px solid var(--line)} }

/* 團隊 */
.team{display:grid; grid-template-columns:repeat(3,1fr); gap:24px}
.team figure{margin:0; background:#fff; border:1px solid var(--line); border-radius:var(--radius); overflow:hidden}
.team img{width:100%; aspect-ratio:3/4; object-fit:cover}
.team figcaption{padding:16px 18px 20px}
.team b{font-size:19px; color:var(--ink); margin-right:8px}
.team small{font-size:12.5px; color:var(--blue); letter-spacing:.14em; font-weight:700}
.team p{margin:8px 0 0; font-size:14px; color:var(--sub)}
.team .pend{color:var(--accent); border:1px dashed var(--accent); padding:4px 8px; display:inline-block; font-size:12.5px}
@media (max-width:820px){ .team{grid-template-columns:1fr; max-width:420px; margin:0 auto} }

/* 聯絡帶 */
.contact-band{background:var(--blue); color:#fff; text-align:center}
.contact-band h2{color:#fff; font-size:clamp(22px,3vw,30px); letter-spacing:.1em; margin-bottom:12px}
.contact-band p{font-size:17px; margin-bottom:6px}
.contact-band a{color:#fff}
.contact-band .btns{justify-content:center}
.contact-band .btn.outline{background:transparent; color:#fff; border-color:#fff}
.contact-band .btn.outline:hover{background:rgba(255,255,255,.12)}
</style>
