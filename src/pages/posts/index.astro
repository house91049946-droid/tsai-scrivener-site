---
// src/pages/posts/index.astro — 專欄列表（側欄分類＋清單，分類用 ?cat= 前端篩選）
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/PageBanner.astro';
import Sidebar from '../../components/Sidebar.astro';
const posts = (await getCollection('posts')).sort((a, b) => +b.data.date - +a.data.date);
const cover: Record<string, string> = { 稅務: 'tax', 繼承實務: 'inherit', 贈與節稅: 'gift', 買賣過戶: 'transfer', 抵押設定: 'mortgage' };
---
<Base title="專欄文章｜遺產稅・贈與稅・繼承實務｜台中中友地政士事務所" description="遺產稅、贈與稅、繼承登記與財產傳承的實務文章。主筆蔡峻豪地政士，每一篇都附法條依據。台中代書推薦。">
  <PageBanner title="專欄文章" sub="ARTICLE" />
  <main class="wrap layout">
    <Sidebar />
    <section class="list">
      <p class="crumb"><a href="/">首頁</a> / 專欄文章</p>
      <h1 class="page-title" id="list-title">全部文章</h1>
      <div class="rows" id="rows">
        {posts.map((p) => (
          <a class="row" data-cat={p.data.category} href={`/posts/${p.id.replace(/\.md$/, '')}/`}>
            <img class="thumb" src={`/illus/cover-${cover[p.data.category] ?? 'tax'}.svg`} alt="" width="800" height="400" loading="lazy" />
            <span class="body">
              <span class="meta"><span class="cat">{p.data.category}</span><time>發佈：{p.data.date.toISOString().slice(0, 10).replaceAll('-', '/')}</time></span>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
            </span>
          </a>
        ))}
      </div>
      <p class="empty" id="empty" hidden>這個分類還沒有文章。</p>
    </section>
  </main>
</Base>
<script>
  const cat = new URLSearchParams(location.search).get('cat');
  const rows = document.querySelectorAll<HTMLElement>('#rows .row');
  let shown = 0;
  rows.forEach((r) => { const on = !cat || r.dataset.cat === cat; r.hidden = !on; if (on) shown++; });
  document.getElementById('empty')!.hidden = shown > 0;
  document.getElementById('list-title')!.textContent = cat ? `${cat}` : '全部文章';
  document.querySelectorAll<HTMLAnchorElement>('.cats a').forEach((a) => a.classList.toggle('on', (a.dataset.cat === (cat ?? 'all'))));
</script>
<style>
.layout{display:grid; grid-template-columns:260px 1fr; gap:clamp(24px,4vw,48px); padding-block:10px 0}
.list .page-title{margin-top:0}
.rows{display:grid; gap:16px}
.row{display:grid; grid-template-columns:200px 1fr; gap:20px; padding:14px; border:1px solid var(--line); border-radius:var(--radius); text-decoration:none; color:var(--text); background:#fff; transition:box-shadow .3s,border-color .3s}
.row:hover{box-shadow:var(--shadow); border-color:var(--blue)}
.row[hidden]{display:none}
.thumb{width:100%; aspect-ratio:2/1; object-fit:cover; border-radius:4px; border:1px solid var(--line)}
.meta{display:flex; gap:14px; align-items:baseline; font-size:12.5px; color:var(--sub)}
.cat{color:var(--blue); font-weight:700; letter-spacing:.12em}
.row h2{font-size:18px; margin:6px 0 6px; line-height:1.5}
.row p{font-size:14px; color:var(--sub); margin:0; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden}
.empty{color:var(--sub); padding:30px 0}
@media (max-width:860px){ .layout{grid-template-columns:1fr} .layout > aside{order:2} .row{grid-template-columns:1fr; gap:10px} }
</style>
