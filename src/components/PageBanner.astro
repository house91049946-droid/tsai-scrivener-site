---
// src/components/PageBanner.astro — 內頁標頭：Marcellus 英文大標＋中文小標，下方橫幅照片
interface Props { title: string; sub?: string; img?: string }
const { title, sub, img = '/photo/banner.webp' } = Astro.props;
const en = sub ? sub.charAt(0) + sub.slice(1).toLowerCase() : title;
---
<header class="pb">
  <div class="wrap">
    <p class="en big">{en}<small>{title}</small></p>
  </div>
  <div class="ph"><img src={img} alt="" width="1800" height="600" /></div>
</header>
<style>
.pb{padding-top:clamp(120px,14vw,190px)}
.big{font-weight:400; font-size:clamp(34px,4.4vw,56px); letter-spacing:.04em; display:flex; align-items:center; gap:18px; flex-wrap:wrap; color:var(--ink); line-height:1.3}
.big small{font-family:"Noto Sans TC",sans-serif; font-size:13px; color:var(--sub); letter-spacing:.16em; display:inline-flex; align-items:center; gap:12px}
.big small::before{content:""; width:16px; height:1px; background:var(--sub)}
.ph{margin-top:clamp(40px,5vw,70px); height:clamp(160px,22vw,320px); overflow:hidden; margin-bottom:clamp(50px,6vw,90px)}
.ph img{width:100%; height:100%; object-fit:cover; object-position:center 55%}
</style>
