---
// src/components/home/Stages.astro
import Stats from './Stats.astro';
---
<section class="block" id="flow" data-io>
  <div class="sec-eyebrow reveal">PROCESS</div>
  <h2 class="reveal d1">傳承規劃流程，透明到底</h2>
  <p class="sec-sub reveal d2">從財產清點到登記完成，每一步做什麼、為什麼、要繳多少稅，都讓你看得見。</p>
  <div class="stages">
    <div class="stage reveal d1">
      <div class="ph">第一步</div><h3>把財產與稅算清楚</h3>
      <ul>
        <li><b>財產清點</b>不動產、存款、股權逐項盤點</li>
        <li><b>稅務試算</b>遺產稅、贈與稅先算出級距與稅額</li>
        <li><b>報價透明</b>規費、稅費、酬金分列明細</li>
      </ul>
    </div>
    <div class="stage reveal d2">
      <div class="ph">第二步</div><h3>選定方案並執行</h3>
      <ul>
        <li><b>方案比較</b>贈與、繼承、買賣三條路的稅負對照</li>
        <li><b>稅務申報</b>遺產稅、贈與稅申報與繳納時點管理</li>
        <li><b>文件審閱</b>分割協議、契約逐條把關</li>
      </ul>
    </div>
    <div class="stage reveal d3">
      <div class="ph">第三步</div><h3>登記完成才算數</h3>
      <ul>
        <li><b>登記送件</b>繼承、贈與移轉登記送件與追蹤</li>
        <li><b>權狀交付</b>正本點交、案卷完整歸檔備查</li>
        <li><b>後續諮詢</b>下一代要處分時仍可回頭問</li>
      </ul>
    </div>
  </div>
  <Stats />
</section>

<style>
section.block{padding:110px 5vw 0; max-width:1200px; margin:0 auto}
.sec-eyebrow{font-size:12px; letter-spacing:.3em; color:var(--gold); font-weight:700; margin-bottom:14px}
h2{font-size:clamp(26px,3.6vw,42px); font-weight:900; line-height:1.35; letter-spacing:.01em; margin-bottom:14px; text-wrap:balance}
.sec-sub{color:var(--sub); font-size:15px; max-width:36em; margin-bottom:44px}
.reveal{opacity:0; transform:translateY(46px)}

.stages{display:grid; grid-template-columns:repeat(3,1fr); gap:18px}
.stage{border:1.5px solid var(--hairline); border-radius:16px; padding:32px 28px; background:var(--paper);
  transition:transform .35s cubic-bezier(.19,1,.22,1), box-shadow .35s, border-color .35s}
.stage:hover{transform:translateY(-6px); box-shadow:0 20px 44px rgba(21,23,28,.08); border-color:var(--gold)}
.stage .ph{font-size:12px; letter-spacing:.26em; color:var(--gold); font-weight:700; margin-bottom:10px}
.stage h3{font-size:20px; font-weight:900; margin-bottom:18px}
.stage ul{list-style:none; padding:0; display:grid; gap:12px}
.stage li{font-size:13.5px; color:var(--sub); padding-left:22px; position:relative}
.stage li::before{content:""; position:absolute; left:0; top:.62em; width:10px; height:2px; background:var(--gold)}
.stage li b{color:var(--ink); display:block; font-size:14px}

@media (max-width:780px){
  .stages{grid-template-columns:1fr}
}
@media (prefers-reduced-motion: reduce){
  .reveal{opacity:1; transform:none; transition:none}
}
</style>
