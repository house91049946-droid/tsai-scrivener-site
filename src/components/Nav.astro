---
// src/components/Nav.astro — 左上 logo、右側直式 Menu／Contact 側欄、全螢幕選單
const links = [
  ['/', '首頁', 'Home'], ['/about/', '關於本所', 'About'], ['/services/', '服務項目', 'Service'],
  ['/posts/', '專欄文章', 'Column'], ['/tools/', '稅費試算', 'Simulator'], ['/fees/', '收費標準', 'Price'],
  ['/faq/', '常見問題', 'Questions'], ['/contact/', '聯絡我們', 'Contact'],
];
---
<a class="logo" id="logo" href="/" aria-label="中友地政士事務所 首頁">
  <svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20 2 36 11v18L20 38 4 29V11z" fill="none" stroke="currentColor" stroke-width="2.2"/><text x="20" y="26.5" text-anchor="middle" font-size="15" fill="currentColor" font-family="Noto Sans TC, sans-serif" font-weight="500">友</text></svg>
  <span><b>中友地政士事務所</b><small class="en">Zhongyou Land Scrivener Office</small></span>
</a>

<button class="burger" id="menu-btn" aria-label="開啟選單" aria-expanded="false" aria-controls="menu"><span></span><span></span><span></span></button>

<aside class="rail" aria-label="側欄">
  <button class="r-menu" id="menu-open" aria-expanded="false" aria-controls="menu"><span class="bars"><i></i><i></i></span><span class="en">Menu</span></button>
  <a class="r-contact" href="/contact/"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M3 6l9 7 9-7" fill="none" stroke="currentColor" stroke-width="1.4"/></svg><span class="en">Contact</span></a>
</aside>

<div class="overlay" id="menu" aria-hidden="true">
  <button class="close en" id="menu-close">Close ✕</button>
  <div class="wrap o-in">
    <nav class="o-nav">
      {links.map(([href, zh, en]) => <a href={href}><span class="en">{en}</span><b>{zh}</b></a>)}
    </nav>
    <div class="o-info">
      <p class="en" style="font-size:22px">Zhongyou Land Scrivener</p>
      <p>台中市東區東英七街 55 號</p>
      <p>TEL. <a href="tel:+886955377283">0955-377-283</a></p>
      <p>LINE <a href="https://line.me/R/ti/p/%400955377283" target="_blank" rel="noopener">@0955377283</a></p>
      <a class="btn light" href="https://line.me/R/ti/p/%400955377283" target="_blank" rel="noopener">LINE 免費諮詢</a>
    </div>
  </div>
</div>

<style>
.logo{position:fixed; left:clamp(18px,2.4vw,34px); top:clamp(16px,2vw,28px); z-index:60; display:flex; align-items:center; gap:12px; text-decoration:none; color:var(--ink); transition:color .4s}
.logo svg{width:36px; height:36px}
.logo b{display:block; font-weight:500; font-size:15px; letter-spacing:.2em; line-height:1.3}
.logo small{display:block; font-size:10.5px; letter-spacing:.08em; opacity:.8; line-height:1.3}
:global(body.on-dark) .logo{color:#fff}
:global(body.scrolled) .logo{color:var(--ink)}
:global(body.scrolled) .logo small{display:none}

/* 右上角漢堡鈕 */
.burger{position:fixed; top:clamp(14px,1.8vw,24px); right:calc(var(--rail) + clamp(16px,2vw,28px)); z-index:95; width:52px; height:52px; border-radius:50%;
  border:1px solid currentColor; background:transparent; color:var(--ink); cursor:pointer; display:grid; place-content:center; gap:5px;
  transition:color .4s, background .3s, border-color .4s}
.burger span{display:block; width:20px; height:1.5px; background:currentColor; transition:transform .45s cubic-bezier(.19,1,.22,1), opacity .3s}
.burger:hover{background:rgba(255,255,255,.12)}
:global(body.on-dark) .burger{color:#fff}
:global(body.scrolled) .burger{color:var(--ink); background:rgba(237,237,237,.85)}
:global(body.menu-open) .burger{color:#fff; background:transparent}
:global(body.menu-open) .burger span:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
:global(body.menu-open) .burger span:nth-child(2){opacity:0}
:global(body.menu-open) .burger span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}

.rail{position:fixed; top:0; right:0; bottom:0; width:var(--rail); z-index:70; display:grid; grid-template-rows:1fr 1fr}
.rail > *{display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; border:0; cursor:pointer; text-decoration:none; font-size:13px}
.rail .en{writing-mode:vertical-rl; letter-spacing:.14em}
.r-menu{background:#E0E0E0; color:var(--ink); transition:background .3s}
.r-menu:hover{background:#D4D4D4}
.bars{display:grid; gap:5px}
.bars i{display:block; width:12px; height:1px; background:currentColor; transform:rotate(90deg)}
.bars{grid-auto-flow:column}
.r-contact{background:var(--char); color:#fff; transition:background .3s}
.r-contact:hover{background:#2E2E2E}
.r-contact svg{width:16px; height:16px}

.overlay{position:fixed; inset:0; z-index:90; background:var(--char-2); color:#fff; display:grid; align-items:center;
  opacity:0; pointer-events:none; transition:opacity .5s ease}
.overlay.open{opacity:1; pointer-events:auto}
.close{position:absolute; left:clamp(18px,2.4vw,34px); top:clamp(22px,2.4vw,34px); background:none; border:0; color:#fff; font-size:15px; letter-spacing:.1em; cursor:pointer}
.o-in{display:grid; grid-template-columns:1.4fr 1fr; gap:60px; align-items:end; width:100%}
.o-nav{display:grid; grid-template-columns:1fr 1fr; gap:6px 40px}
.o-nav a{display:flex; align-items:baseline; gap:18px; padding:14px 0; border-bottom:1px solid rgba(255,255,255,.18); text-decoration:none; color:#fff;
  transform:translateY(16px); opacity:0; transition:transform .6s cubic-bezier(.19,1,.22,1), opacity .6s, padding-left .35s}
.overlay.open .o-nav a{transform:none; opacity:1}
.overlay.open .o-nav a:nth-child(n){transition-delay:calc(var(--i,0) * 40ms)}
.o-nav a:hover{padding-left:10px}
.o-nav .en{font-size:clamp(22px,2.2vw,30px); min-width:5.6em}
.o-nav b{font-weight:400; font-size:13px; color:rgba(255,255,255,.7); letter-spacing:.14em}
.o-info{display:grid; gap:4px; font-size:14px; color:rgba(255,255,255,.8)}
.o-info a{color:#fff}
.o-info .btn{margin-top:22px; justify-self:start}

@media (max-width:960px){
  .rail{display:none}
  .burger{right:16px; width:46px; height:46px}
  .logo small{display:none}
  .o-in{grid-template-columns:1fr; gap:30px}
  .o-nav{grid-template-columns:1fr}
  .o-nav a{padding:10px 0}
}
</style>
