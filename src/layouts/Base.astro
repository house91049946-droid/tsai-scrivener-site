---
// src/layouts/Base.astro
import '@fontsource/noto-sans-tc/400.css';
import '@fontsource/noto-sans-tc/700.css';
import '@fontsource/noto-sans-tc/900.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title: string;
  description: string;
  article?: { publishedTime: string; category: string };
}
const { title, description, article } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonical} />
  {article && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      datePublished: article.publishedTime,
      author: { '@type': 'Person', name: '蔡峻豪', jobTitle: '地政士' },
      articleSection: article.category,
    })} />
  )}
  <noscript>
    <style>
      .reveal, .line-inner, .eyebrow, .hero .sub, .names, .btns, .portrait {
        opacity: 1 !important;
        transform: none !important;
      }
    </style>
  </noscript>
</head>
<body>
  <Nav />
  <slot />
  <Footer />
  <script>
    import '../scripts/motion.ts';
  </script>
</body>
</html>
